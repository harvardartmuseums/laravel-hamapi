{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "phpdoc_order": true,
        "phpdoc_separation": true,
        "phpdoc_single_line_var_spacing": true,
        "phpdoc_trim": true,
        "phpdoc_types_order": {
            "null_adjustment": "always_last",
            "sort_algorithm": "none"
        }
    }
}