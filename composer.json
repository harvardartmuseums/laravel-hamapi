{
    "name": "harvardartmuseums/laravel-hamapi",
    "description": "HAM API integration for Laravel",
    "keywords": ["laravel", "art", "harvard", "api", "museum"],
    "license": "MIT",
    "authors": [
        {
            "name": "Harvard Art Museums",
            "email": "support@harvardartmuseums.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Harvardartmuseums\\HamAPI\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Harvardartmuseums\\HamAPI\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Harvardartmuseums\\HamAPI\\Providers\\HamApiServiceProvider"
            ],
            "aliases": {
                "HamApi": "Harvardartmuseums\\HamAPI\\Facades\\HamApi"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}