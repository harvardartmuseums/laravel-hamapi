# Harvard Art Museums API Configuration
# Get your API key from: https://www.harvardartmuseums.org/collections/api

HAM_API_KEY=your-api-key-here
HAM_API_BASE_URL=https://api.harvardartmuseums.org

# Optional: Cache Configuration
HAM_API_CACHE_ENABLED=true
HAM_API_CACHE_TTL=900
HAM_API_CACHE_PREFIX=hamapi

# Optional: Request Configuration
HAM_API_REQUEST_TIMEOUT=30
HAM_API_RETRY_TIMES=3
HAM_API_RETRY_DELAY=100

# Optional: Logging Configuration
HAM_API_LOGGING_ENABLED=true
HAM_API_LOG_CHANNEL=stack

